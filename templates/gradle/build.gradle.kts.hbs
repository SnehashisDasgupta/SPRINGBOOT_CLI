plugins {
    java
    id("org.springframework.boot") version "{{springBootVersion}}"
    id("io.spring.dependency-management") version "1.1.4"
}

group = "{{group}}"
version = "{{version}}"

java {
    sourceCompatibility = JavaVersion.VERSION_{{javaVersion}}
}

repositories {
    mavenCentral()
}

dependencies {
    {{#each dependencies}}
    {{this.configuration}}("{{this.notation}}")
    {{/each}}
}

tasks.withType<Test> {
    useJUnitPlatform()
}