server:
  port: {{port}}

spring:
  application:
    name: {{artifact}}
  
  datasource:
    # TODO: Update these values with your database details
    url: {{database.url}}
    username: {{database.username}}
    password: {{database.password}}
    driver-class-name: {{database.driverClassName}}
  
  jpa:
    database-platform: {{database.dialect}}
    hibernate:
      ddl-auto: {{database.ddlAuto}}
    show-sql: {{database.showSql}}
    properties:
      hibernate:
        format_sql: {{database.formatSql}}

logging:
  level:
    org.springframework: INFO
    {{packageName}}: DEBUG
```

